{
  "name": "jd-helper",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "prisma:deploy": "dotenv -e .env.local -- node scripts/prisma-command.js migrate deploy",
    "prisma:generate": "dotenv -e .env.local -- node scripts/prisma-command.js generate",
    "prisma:migrate": "dotenv -e .env.local -- node scripts/prisma-command.js --use-pooled-direct-url migrate dev",
    "prisma:migrate:pooled": "dotenv -e .env.local -- node scripts/prisma-command.js --use-pooled-direct-url migrate dev",
    "db:apply-stage4": "dotenv -e .env.local -- node scripts/apply-stage4-sql.js",
    "db:apply-memory": "dotenv -e .env.local -- node scripts/apply-memory-sql.js",
    "db:apply-ai-config": "dotenv -e .env.local -- node scripts/apply-ai-config-sql.js",
    "prisma:studio": "dotenv -e .env.local -- node scripts/prisma-command.js studio",
    "prisma:validate": "dotenv -e .env.local -- node scripts/prisma-command.js validate"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.63",
    "@ai-sdk/openai-compatible": "^2.0.38",
    "@clerk/nextjs": "5.2.4",
    "@hookform/resolvers": "^3.9.0",
    "@napi-rs/canvas": "^1.0.0",
    "@neondatabase/serverless": "^1.0.2",
    "@prisma/adapter-neon": "^6.19.3",
    "@prisma/client": "6.19.3",
    "ai": "^6.0.146",
    "mammoth": "^1.12.0",
    "next": "^14.2.0",
    "pdfjs-dist": "^5.7.284",
    "pg": "^8.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "tesseract.js": "^7.0.0",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.20",
    "dotenv-cli": "^8.0.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.0",
    "postcss": "^8.4.47",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2"
  }
}
