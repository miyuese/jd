generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum MaterialSourceType {
  MANUAL_TEXT
  FILE_UPLOAD
}

enum FactStatus {
  CONFIRMED
  NEEDS_CONFIRMATION
  EXPRESSION_SUGGESTION
}

enum ProjectCardStatus {
  DRAFT
  PENDING_CONFIRMATION
  CONFIRMED
}

enum MatchAnalysisStatus {
  DRAFT
  PENDING_CONFIRMATION
  CONFIRMED
}

enum VersionType {
  PROJECT_CARD
  MATCH_ANALYSIS
  OUTPUT
}

model ResumeMaterial {
  id          String   @id @default(cuid())
  clerkUserId String
  title       String   @default("已有简历")
  rawText     String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  projectCards ProjectCard[]

  @@index([clerkUserId, updatedAt])
}

model Project {
  id              String                 @id @default(cuid())
  clerkUserId     String
  name            String
  targetRole      String
  currentNeed     String                 @db.Text
  status          ProjectStatus          @default(DRAFT)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  materials       ProjectMaterial[]
  questionAnswers QuestionAnswerRecord[]
  projectCards    ProjectCard[]
  jdRecords       JdRecord[]
  matchAnalyses   MatchAnalysis[]
  versionRecords  VersionRecord[]
}

model ProjectMaterial {
  id            String             @id @default(cuid())
  projectId     String?
  clerkUserId   String
  sourceType    MaterialSourceType @default(MANUAL_TEXT)
  title         String?
  projectName   String?
  rawText       String             @db.Text
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  project       Project?           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  questionAnswers QuestionAnswerRecord[]
  cardLinks     ProjectCardMaterial[]

  @@index([clerkUserId, updatedAt])
}

model QuestionAnswerRecord {
  id                String          @id @default(cuid())
  projectId         String?
  projectMaterialId String?
  clerkUserId       String
  roundIndex        Int             @default(1)
  questionText      String          @db.Text
  answerText        String          @db.Text
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  project           Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectMaterial   ProjectMaterial? @relation(fields: [projectMaterialId], references: [id], onDelete: Cascade)

  @@index([clerkUserId, updatedAt])
}

model ProjectCard {
  id                       String            @id @default(cuid())
  projectId                String?
  clerkUserId              String
  title                    String?
  background               String?           @db.Text
  backgroundFactStatus     FactStatus        @default(NEEDS_CONFIRMATION)
  responsibility           String?           @db.Text
  responsibilityFactStatus FactStatus        @default(NEEDS_CONFIRMATION)
  result                   String?           @db.Text
  resultFactStatus         FactStatus        @default(NEEDS_CONFIRMATION)
  status                   ProjectCardStatus @default(PENDING_CONFIRMATION)
  resumeMaterialId         String?
  isCurrentProjectCard     Boolean           @default(false)
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  project                  Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  materials                ProjectCardMaterial[]
  resumeMaterial           ResumeMaterial?   @relation(fields: [resumeMaterialId], references: [id], onDelete: SetNull)

  @@index([clerkUserId, updatedAt])
}

model ProjectCardMaterial {
  id                String          @id @default(cuid())
  projectCardId     String
  projectMaterialId String
  projectCard       ProjectCard     @relation(fields: [projectCardId], references: [id], onDelete: Cascade)
  projectMaterial   ProjectMaterial @relation(fields: [projectMaterialId], references: [id], onDelete: Cascade)

  @@unique([projectCardId, projectMaterialId])
}

model JdRecord {
  id                String          @id @default(cuid())
  projectId         String
  clerkUserId       String
  rawText           String          @db.Text
  capabilitySummary Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  matchAnalyses     MatchAnalysis[]
}

model MatchAnalysis {
  id               String              @id @default(cuid())
  projectId        String?
  jdRecordId       String?
  projectCardId    String?
  clerkUserId      String
  status           MatchAnalysisStatus @default(DRAFT)
  matchedPoints    Json?
  gapPoints        Json?
  suggestionPoints Json?
  summary          String?             @db.Text
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  project          Project?            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  jdRecord         JdRecord?           @relation(fields: [jdRecordId], references: [id], onDelete: SetNull)
  projectCard      ProjectCard?        @relation(fields: [projectCardId], references: [id], onDelete: SetNull)

  @@index([clerkUserId, updatedAt])
}

model VersionRecord {
  id                     String           @id @default(cuid())
  projectId              String?
  clerkUserId            String
  type                   VersionType
  title                  String
  content                Json
  sourceResumeMaterialId String?
  sourceProjectCardId    String?
  sourceMatchAnalysisId  String?
  jdRecordId             String?
  createdAt              DateTime         @default(now())
  project                Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  citations              JdOutputCitation[]

  @@index([clerkUserId, createdAt])
}

// ========== 个人记忆系统（V1.1，Jd 前缀避免与原作者表冲突） ==========

enum MemorySourceType {
  RESUME
  PROJECT_MATERIAL
  INTERVIEW_ANSWER
  INTERVIEW_FEEDBACK
  REFLECTION
  MANUAL
}

enum AbilityCategory {
  PERSONA
  GENERAL
  ROLE_SPECIFIC
}

enum TagStatus {
  DRAFT
  CONFIRMED
  REJECTED
}

enum CitationKind {
  DIRECT_QUOTE
  PARAPHRASE
  INFERENCE
}

model JdMemorySource {
  id          String            @id @default(cuid())
  clerkUserId String
  sourceType  MemorySourceType
  title       String?
  rawText     String            @db.Text
  sourceRefId String?
  projectId   String?
  createdAt   DateTime          @default(now())
  chunks      JdMemoryChunk[]
}

model JdMemoryChunk {
  id         String          @id @default(cuid())
  sourceId   String
  content    String          @db.Text
  chunkIndex Int             @default(0)
  createdAt  DateTime        @default(now())
  source     JdMemorySource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
}

model JdAbilityTag {
  id          String          @id @default(cuid())
  clerkUserId String
  name        String
  category    AbilityCategory
  description String?         @db.Text
  confidence  Float           @default(0.5)
  status      TagStatus       @default(DRAFT)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model JdOutputCitation {
  id          String        @id @default(cuid())
  clerkUserId String
  versionId   String
  sentenceId  String
  chunkId     String
  kind        CitationKind  @default(PARAPHRASE)
  createdAt   DateTime      @default(now())
  version     VersionRecord @relation(fields: [versionId], references: [id], onDelete: Cascade)
}

// 标签 ↔ 证据多对多链接表
model JdMemoryTagChunk {
  tagId   String
  chunkId String

  @@id([tagId, chunkId])
}

// ========== AI 模型配置（V1.2，可在设置页动态切换） ==========

model JdAiProviderConfig {
  id             String   @id @default(cuid())
  ownerUserId    String   // 配置所有者：只有 owner 可以编辑
  providerName   String   @default("openai-compatible")
  baseURL        String
  apiKey         String
  primaryModel   String
  fallbackModels Json?    // ["model-b", "model-c"] 备用模型列表
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([ownerUserId])
}
