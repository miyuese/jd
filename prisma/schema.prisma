generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum MaterialSourceType {
  MANUAL_TEXT
  FILE_UPLOAD
}

enum FactStatus {
  CONFIRMED
  NEEDS_CONFIRMATION
  EXPRESSION_SUGGESTION
}

enum ProjectCardStatus {
  DRAFT
  PENDING_CONFIRMATION
  CONFIRMED
}

enum MatchAnalysisStatus {
  DRAFT
  PENDING_CONFIRMATION
  CONFIRMED
}

enum VersionType {
  PROJECT_CARD
  MATCH_ANALYSIS
  OUTPUT
}

model ResumeMaterial {
  id          String   @id @default(cuid())
  clerkUserId String
  title       String   @default("已有简历")
  rawText     String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id              String               @id @default(cuid())
  clerkUserId     String
  name            String
  targetRole      String
  currentNeed     String               @db.Text
  status          ProjectStatus        @default(DRAFT)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  materials       ProjectMaterial[]
  questionAnswers QuestionAnswerRecord[]
  projectCards    ProjectCard[]
  jdRecords       JdRecord[]
  matchAnalyses   MatchAnalysis[]
  versionRecords  VersionRecord[]
}

model ProjectMaterial {
  id          String             @id @default(cuid())
  projectId   String
  clerkUserId String
  sourceType  MaterialSourceType @default(MANUAL_TEXT)
  title       String?
  rawText     String             @db.Text
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model QuestionAnswerRecord {
  id           String   @id @default(cuid())
  projectId    String
  clerkUserId  String
  roundIndex   Int      @default(1)
  questionText String   @db.Text
  answerText   String   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectCard {
  id                       String            @id @default(cuid())
  projectId                String
  clerkUserId              String
  title                    String?
  background               String?           @db.Text
  backgroundFactStatus     FactStatus        @default(NEEDS_CONFIRMATION)
  responsibility           String?           @db.Text
  responsibilityFactStatus FactStatus        @default(NEEDS_CONFIRMATION)
  result                   String?           @db.Text
  resultFactStatus         FactStatus        @default(NEEDS_CONFIRMATION)
  status                   ProjectCardStatus @default(PENDING_CONFIRMATION)
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  project                  Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model JdRecord {
  id                String          @id @default(cuid())
  projectId         String
  clerkUserId       String
  rawText           String          @db.Text
  capabilitySummary Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  matchAnalyses     MatchAnalysis[]
}

model MatchAnalysis {
  id               String              @id @default(cuid())
  projectId        String
  jdRecordId       String?
  clerkUserId      String
  status           MatchAnalysisStatus @default(DRAFT)
  matchedPoints    Json?
  gapPoints        Json?
  suggestionPoints Json?
  summary          String?             @db.Text
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  project          Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  jdRecord         JdRecord?           @relation(fields: [jdRecordId], references: [id], onDelete: SetNull)
}

model VersionRecord {
  id                    String      @id @default(cuid())
  projectId             String
  clerkUserId           String
  type                  VersionType
  title                 String
  content               Json
  sourceResumeMaterialId String?
  sourceProjectCardId   String?
  sourceMatchAnalysisId String?
  createdAt             DateTime    @default(now())
  project               Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
